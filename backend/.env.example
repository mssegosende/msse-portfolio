# Copy to backend/.env for local development. On Vercel, set these in the
# project's Settings -> Environment Variables. Never commit real values.

# Resend API key (resend.com -> API Keys).
RESEND_API_KEY=
# The inbox that receives the messages. With the onboarding@resend.dev sender it
# must be the email your Resend account was created with.
CONTACT_TO_EMAIL=
# Comma-separated origins allowed to call the API, no trailing slash.
# e.g. https://msse-portfolio.vercel.app,http://localhost:3000
CORS_ORIGINS=
# "1" turns on FastAPI's /docs, /redoc and /openapi.json. Local only: leave it
# unset on Vercel.
API_DOCS=
