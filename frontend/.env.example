# Optional. Overrides the contact service's base URL, without a trailing slash.
# Unset: production calls the same origin (/api/contact), dev calls
# http://localhost:8000.
# VITE_BACKEND_URL=http://localhost:8000
# Cloudflare Turnstile's site key (public). Unset: no widget. Read at build
# time: after setting it in Vercel, redeploy. Pairs with TURNSTILE_SECRET_KEY on
# the backend.
VITE_TURNSTILE_SITE_KEY=
